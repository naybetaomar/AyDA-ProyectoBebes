@startuml
' ER Área 4 - Aprobaciones y periodos contables (notación pata de gallo)
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 70
skinparam class {
  BackgroundColor #F7F9FC
  BorderColor #3B5B92
}

entity "Usuario" as Usuario <<externa>> {
  * id : BIGINT <<PK>>
}

entity "Factura" as Factura <<externa>> {
  * id : BIGINT <<PK>>
  --
  periodo_id : BIGINT <<FK>>
}

entity "PaqueteContable" as PaqueteContable <<externa>> {
  * id : BIGINT <<PK>>
  --
  * periodo_id : BIGINT <<FK>>
}

entity "SolicitudExcepcion" as SolicitudExcepcion {
  * id : BIGINT <<PK>>
  --
  * tipo : TipoSolicitud
  * importe : DECIMAL
  * estado : EstadoSolicitud
  comentarioAprobador : VARCHAR
  * fecha : DATETIME
  --
  * factura_id : BIGINT <<FK>>
  * solicitante_id : BIGINT <<FK>>
  aprobador_id : BIGINT <<FK>>
}

entity "PeriodoContable" as PeriodoContable {
  * id : BIGINT <<PK>>
  --
  * tipo : TipoPeriodo
  * inicio : DATETIME
  * fin : DATETIME
  * estado : EstadoPeriodo
}

entity "ReaperturaPeriodo" as ReaperturaPeriodo {
  * id : BIGINT <<PK>>
  --
  * motivo : VARCHAR
  * fecha : DATETIME
  --
  * periodo_id : BIGINT <<FK>>
  * usuario_id : BIGINT <<FK>>
}

Usuario ||--o{ SolicitudExcepcion : solicita
Usuario |o--o{ SolicitudExcepcion : resuelve
Factura ||--o{ SolicitudExcepcion : "sobre"
PeriodoContable |o--o{ Factura : "pertenece a"
PeriodoContable ||--o{ ReaperturaPeriodo : tiene
PeriodoContable ||--o{ PaqueteContable : tiene
Usuario ||--o{ ReaperturaPeriodo : "realizada por"

note bottom of SolicitudExcepcion
  TipoSolicitud: DESCUENTO, CAMBIO_IMPORTE, CAMBIO_FECHA,
  FACTURA_SOBRE_UMBRAL, EXCEPCION_PRORRATEO, BAJA_CONTABLE
  EstadoSolicitud: PENDIENTE, APROBADA, RECHAZADA
  comentarioAprobador obligatorio si RECHAZADA
end note

note bottom of PeriodoContable
  TipoPeriodo: MES, TRIMESTRE
  EstadoPeriodo: ABIERTO, CERRADO
end note
@enduml
