@startuml
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 70

class ServicioEnvio {
    + enviar(mensaje : Mensaje) : boolean
}

class ServicioRecordatorios {
    + procesarVencimientos() : void
    + pausar(factura : Factura) : void
    + reanudar(factura : Factura) : void
}

class PlantillaComunicacion{
    - id : Long
    - tipo : TipoPlantilla
    - asunto : String
    - cuerpo : String
    - variablesObligatorias : List<String>
    - activa : Boolean
}

class ReglaRecordatorio{
    - cadencia : Integer
    - diasTrasVencimiento : Integer
    - activa : boolean
}

note right of ReglaRecordatorio
  Escucha el evento "estado de cobro
  cambiado" del área 6 (8.12 del catálogo)
  para pausar o reanudar los recordatorios.
end note

class Mensaje{
    - canal : Canal
    - estadoEntrega : EstadoEntrega
    - intentos : Integer
    - fechaEnvio : LocalDateTime
}

class Factura
class Contacto

interface CanalEnvio {
  + enviar(mensaje : Mensaje) : boolean
}

class AdaptadorCorreo
class AdaptadorWhatsApp

class ServicioCorreoSimulado {
    + enviarCorreo(destino : String, asunto : String, cuerpo : String) : boolean
}

class ServicioWhatsAppSimulado {
    + enviarWhatsApp(telefono : String, texto : String) : boolean
}

enum TipoPlantilla{
    FACTURA
    RECORDATORIO
}

enum EstadoEntrega{
    PENDIENTE
    ENVIADO
    ENTREGADO
    FALLIDO
}

enum Canal{
    EMAIL
    WHATSAPP
}

' --- Servicios ---
ServicioRecordatorios ..> ReglaRecordatorio : aplica
ServicioRecordatorios --> ServicioEnvio : usa
ServicioEnvio --> CanalEnvio : elige canal y llama a enviar

' --- Adapter ---
CanalEnvio <|.. AdaptadorCorreo
CanalEnvio <|.. AdaptadorWhatsApp
AdaptadorCorreo --> ServicioCorreoSimulado : adapta
AdaptadorWhatsApp --> ServicioWhatsAppSimulado : adapta

' --- Datos ---
ReglaRecordatorio "0..*" --> "1" PlantillaComunicacion : usa
Factura "1" -right-> "0..*" Mensaje : genera
Contacto "1" -left-> "0..*" Mensaje : recibe
PlantillaComunicacion "1" -down-> "0..*" Mensaje : genera

Mensaje .down.> Canal
Mensaje .right.> EstadoEntrega
PlantillaComunicacion .left.> TipoPlantilla
@enduml