@startuml
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 70
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam roundCorner 8
skinparam ArrowColor #444444
skinparam class {
  BackgroundColor #F7F9FC
  BorderColor #3B5B92
}
skinparam enum {
  BackgroundColor #FFF8E5
  BorderColor #B88A00
}

enum EstadoSolicitud {
    PENDIENTE
    APROBADA
    RECHAZADA
}

enum TipoSolicitud {
    DESCUENTO
    CAMBIO_IMPORTE
    CAMBIO_FECHA
    FACTURA_SOBRE_UMBRAL
    EXCEPCION_PRORRATEO
    BAJA_CONTABLE
}

enum TipoPeriodo {
    MES
    TRIMESTRE
}

enum EstadoPeriodo {
    ABIERTO
    CERRADO
}

class Usuario
class Factura
class PaqueteContable

class ServicioAprobaciones {
  + solicitar(factura : Factura, solicitante : Usuario, tipo : TipoSolicitud, importe : BigDecimal) : SolicitudExcepcion
  + aprobar(solicitud : SolicitudExcepcion, aprobador : Usuario) : void
  + rechazar(solicitud : SolicitudExcepcion, aprobador : Usuario, comentario : String) : void
}

note right of ServicioAprobaciones::rechazar
  El comentario del aprobador
  es obligatorio al rechazar.
end note

note left of ServicioAprobaciones
  Al aprobar o rechazar, emite el evento
  «solicitud resuelta» (cuestión 8.12).
  Lo escuchan: área 3 (emite la factura o la
  devuelve a borrador), área 6 (registra la
  baja contable) y área 7 (avisa al solicitante).
  Mecanismo: Observer (E3).
end note

class SolicitudExcepcion {
  - id : Long
  - tipo : TipoSolicitud
  - importe : BigDecimal
  - estado : EstadoSolicitud
  - comentarioAprobador : String
  - fecha : LocalDateTime
}

class PeriodoContable {
  - id : Long
  - tipo : TipoPeriodo
  - inicio : LocalDateTime
  - fin : LocalDateTime
  - estado : EstadoPeriodo
  + cerrar() : void
  + reabrir(motivo : String, usuario : Usuario) : ReaperturaPeriodo
}

class ReaperturaPeriodo {
  - motivo : String
  - fecha : LocalDateTime
}

' --- Servicio ---
ServicioAprobaciones .down.> SolicitudExcepcion : gestiona

' --- Relaciones (flujo vertical) ---
Usuario "1" -down-> "0..*" SolicitudExcepcion : solicita
Usuario "0..1" -down-> "0..*" SolicitudExcepcion : resuelve
SolicitudExcepcion "0..*" -down-> "1" Factura : sobre
Factura "0..*" -down-> "0..1" PeriodoContable : pertenece a
PeriodoContable "1" -down-> "0..*" ReaperturaPeriodo : tiene
PeriodoContable "1" -down-> "0..*" PaqueteContable : tiene
ReaperturaPeriodo "0..*" -left-> "1" Usuario : realizada por

' --- Enums a los lados ---
SolicitudExcepcion .right.> EstadoSolicitud
SolicitudExcepcion .left.> TipoSolicitud
PeriodoContable .left.> TipoPeriodo
PeriodoContable .right.> EstadoPeriodo
@enduml