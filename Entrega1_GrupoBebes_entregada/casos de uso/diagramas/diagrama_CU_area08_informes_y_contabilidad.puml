@startuml
' Diagrama  - Informes y contabilidad (CU-XX = especificación en el .md)
title Informes y contabilidad 
left to right direction
skinparam packageStyle rectangle

actor "Lector" as Lector
actor "Administrador" as Admin
actor "Superadministrador" as Super
Admin --|> Lector
Super --|> Admin

rectangle "Aplicación de facturación y cobros" {
  usecase "CU-42\nConsultar dashboard financiero" as CU42
  usecase "CU-43\nGenerar y exportar informes" as CU43
  usecase "CU-44\nProgramar informes periódicos (opcional)" as CU44
  usecase "CU-45\nFijar objetivos de facturación y cobro" as CU45
  usecase "CU-46\nGenerar paquete contable del periodo" as CU46
  usecase "CU-47\nConsultar eficiencia operativa" as CU47
}
Admin --> CU42
Lector --> CU43
Admin --> CU44
Admin --> CU45
Admin --> CU46
Super --> CU47
@enduml
