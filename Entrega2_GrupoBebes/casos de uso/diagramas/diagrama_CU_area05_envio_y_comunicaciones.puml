@startuml
' Diagrama  - Envío y comunicaciones (CU-XX = especificación en el .md)
title Envío y comunicaciones 
left to right direction
skinparam packageStyle rectangle

actor "Lector" as Lector
actor "Administrador" as Admin
actor "Superadministrador" as Super
Admin --|> Lector
Super --|> Admin

rectangle "Aplicación de facturación y cobros" {
  usecase "CU-27\nEnviar factura al cliente" as CU27
  usecase "CU-28\nGestionar fallo de envío de una factura" as CU28
  usecase "CU-29\nEnviar recordatorios de pago automáticos" as CU29
  usecase "CU-30\nConfigurar recordatorios y plantillas" as CU30
  usecase "CU-31\nMarcar factura en disputa" as CU31
  usecase "CU-32\nConsultar estado de entrega de mensajes" as CU32
}
Lector -- CU27
Lector -- CU28
Lector -- CU29
Super -- CU30
Admin -- CU30
Admin -- CU31
Lector -- CU32
note right of CU28 : Precondición: existe una incidencia de envío fallido (CU-27)
@enduml
