@startuml
' Diagrama - Clientes y contactos (CU-XX = especificación en el .md)
title Clientes y contactos
left to right direction
skinparam packageStyle rectangle

actor "Lector" as Lector
actor "Administrador" as Admin
Admin --|> Lector

rectangle "Aplicación de facturación y cobros" {
  usecase "CU-01\nRegistrar cliente" as CU01
  usecase "CU-02\nConsultar cliente e historial" as CU02
  usecase "CU-03\nGestionar contactos y preferencias de comunicación" as CU03
  usecase "CU-04\nAdjuntar documentos a cliente o factura" as CU04
  usecase "CU-05\nImportar clientes desde CSV" as CU05
  usecase "CU-06\nImportar histórico de facturas" as CU06
  usecase "CU-07\nEjecutar acción masiva sobre clientes" as CU07
  usecase "CU-08\nEtiquetar clientes y clasificar facturas (opcional)" as CU08
  usecase "CU-09\nGestionar privacidad de datos personales" as CU09
}
Lector -- CU01
Lector -- CU02
Lector -- CU03
Lector -- CU04
Lector -- CU05
Admin -- CU06
Lector -- CU07
Lector -- CU08
Admin -- CU09
note right of CU06 : Precondición: clientes ya registrados o importados
@enduml
