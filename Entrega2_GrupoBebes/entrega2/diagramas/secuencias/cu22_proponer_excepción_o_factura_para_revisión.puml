@startuml seq_cu22_proponer_excepcion
title CU-22 · Proponer excepción o factura para revisión

actor "Usuario operativo" as Op
boundary "InterfazFacturacion" as UI
control "ProxyPermisos" as Proxy
control "ServicioFacturacion" as ServFact
entity "Factura" as Fact
control "ServicioAprobaciones" as ServAprob
entity "SolicitudExcepcion" as Sol
control "ServicioNotificaciones" as ServNotif
entity "RegistroAuditoria" as Audit

Op -> UI : enviarARevision(facturaId, tipoExcepcion, motivo)
activate UI

UI -> Proxy : proponerRevision(usuario, facturaId, tipoExcepcion, motivo)
activate Proxy
Proxy -> Proxy : comprobarPermiso(usuario, facturaId)

Proxy -> ServFact : enviarFacturaARevision(facturaId, tipoExcepcion, motivo, usuario)
activate ServFact

ServFact -> Fact : pasarAPendienteAprobacion(motivo, usuario)
activate Fact
note right of Fact
  La factura pasa a estadoDocumental =
  PENDIENTE_APROBACION sin recibir
  número ni emitirse (RB-25).
end note
Fact --> ServFact : datosSolicitud(importe, factura)
deactivate Fact

ServFact -> ServAprob : crearSolicitud(tipoExcepcion, importe, factura, usuario, motivo)
activate ServAprob

create Sol
ServAprob -> Sol : crear(PENDIENTE, tipoExcepcion, importe, factura, usuario, motivo)
ServAprob --> ServFact : solicitud
deactivate ServAprob

ServFact -> ServNotif : notificarAprobadores(solicitud)
activate ServNotif
ServNotif --> ServFact : ok
deactivate ServNotif

ServFact -> Audit : registrar(usuario, "SolicitudExcepcion", "CREAR", null, solicitud)
activate Audit
Audit --> ServFact : ok
deactivate Audit

ServFact --> Proxy : solicitud
deactivate ServFact

Proxy --> UI : solicitud
deactivate Proxy

UI --> Op : mostrarConfirmacionPendiente(solicitud)
deactivate UI
@enduml