@startuml cu58_enviar_solicitud_api
title CU-58 Enviar solicitud mediante la API — «Cliente solicita baja» (FE-1 como alternativa)
hide footbox
skinparam maxMessageSize 140
autonumber "0:"
skinparam sequenceParticipantBackgroundColor #FFFFCC
skinparam sequenceParticipantBorderColor #A80036
skinparam sequenceArrowColor #A80036
skinparam sequenceLifeLineBorderColor #A80036

actor "__: Sistema externo__" as SE
participant "__: FachadaAPI__" as FA
participant "__c : ConsumidorAPI__" as C
participant "__: ContextoSeguridad__" as CS
participant "__: ProxyRelacionComercial__" as PR
participant "__: ServicioRelacionComercial__" as SR
participant "__: ProxyNotificaciones__" as PN
participant "__: ServicioNotificaciones__" as SN

SE -> FA ++ : enviarSolicitud(credencial : String, tipo = BAJA, clienteId : Long)

' ---------- Autenticar al consumidor y comprobar el límite ----------
FA ->o] : buscar ConsumidorAPI con el hash de la credencial en BD
autonumber stop
FA <--o] : c o nada
autonumber resume

alt no existe consumidor con esa credencial, o c.autenticar() = false
  create participant "__l : LlamadaAPI__" as L
  FA --> L : LlamadaAPI(consumidor = c o nulo, operacion = ENVIAR_SOLICITUD, resultado = NO_AUTORIZADA)
  FA ->o] : guardar l en BD
  autonumber stop
  FA --> SE : NO_AUTORIZADA
  autonumber resume
else c.haAlcanzadoLimite() = true
  FA --> L : LlamadaAPI(consumidor = c, operacion = ENVIAR_SOLICITUD, resultado = LIMITE_EXCEDIDO)
  FA ->o] : guardar l en BD
  autonumber stop
  FA --> SE : LIMITE_EXCEDIDO
  autonumber resume
else credencial válida y dentro del límite
  FA -> C ++ : autenticar(credencial : String)
  autonumber stop
  return true
  autonumber resume
  FA -> C ++ : haAlcanzadoLimite()
  autonumber stop
  return false
  autonumber resume

  FA -> CS ++ : establecer(solicitante = identidad de la API : IdentidadSistema)
  autonumber stop
  return
  autonumber resume
  FA ->o] : buscar cliente con clienteId en BD
  autonumber stop
  FA <--o] : cliente
  autonumber resume

  ' ---------- Paso 2: validar con las mismas reglas que la interfaz ----------
  FA -> PR ++ : comprobarBaja(cliente : Cliente, fecha = hoy)
  PR -> PR : autorizarYRegistrar(operacion : OperacionProtegida, cliente : Cliente)
  PR -> SR ++ : comprobarBaja(cliente : Cliente, fecha : Date)
  SR ->o] : buscar relación comercial del cliente en BD
  autonumber stop
  SR <--o] : relación
  SR --> PR : motivo [0..1]
  deactivate SR
  PR --> FA : motivo
  deactivate PR
  autonumber resume
  note right of SR
    Misma regla que darDeBaja()
    en CU-12 (RB-31).
    Nulo = se puede dar de baja.
  end note

  create participant "__s : SolicitudExterna__" as S
  FA --> S : SolicitudExterna(tipo = BAJA, consumidor = c, cliente)

  alt hay motivo: no cumple las reglas de negocio (FE-1)
    FA -> S ++ : rechazar(motivo : String)
    autonumber stop
    return
    autonumber resume
    FA ->o] : guardar s en BD
    FA --> L : LlamadaAPI(consumidor = c, operacion = ENVIAR_SOLICITUD, resultado = RECHAZADA)
    FA ->o] : guardar l en BD
    autonumber stop
    FA --> SE : RECHAZADA
    autonumber resume
  else sin motivo: se crea la tarea de revisión (paso 3, CU-12 FA-1)
    FA -> PN ++ : crearTarea(tipo = REVISION_BAJA, descripcion : String, cliente : Cliente, origen = "API")
    PN -> PN : autorizarYRegistrar(operacion : OperacionProtegida, cliente : Cliente)
    PN -> SN ++ : crearTarea(tipo : TipoTarea, descripcion : String, cliente : Cliente, origen : String)
    create participant "__t : Tarea__" as T
    SN --> T : Tarea(tipo = REVISION_BAJA, estado = PENDIENTE, responsable = nulo)
    SN ->o] : guardar t en BD
    autonumber stop
    SN --> PN : t
    deactivate SN
    PN --> FA : t
    deactivate PN
    autonumber resume
    FA -> S ++ : validar(tarea = t)
    autonumber stop
    return
    autonumber resume
    FA ->o] : guardar s en BD
    FA --> L : LlamadaAPI(consumidor = c, operacion = ENVIAR_SOLICITUD, resultado = CORRECTA)
    FA ->o] : guardar l en BD
    ' ---------- Paso 4: informar del resultado ----------
    autonumber stop
    FA --> SE : CORRECTA
    autonumber resume
  end
end
deactivate FA

@enduml
