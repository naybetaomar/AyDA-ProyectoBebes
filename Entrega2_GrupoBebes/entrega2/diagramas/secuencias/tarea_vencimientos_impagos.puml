@startuml tarea_vencimientos_impagos
title Tarea diaria del planificador — Vencimientos y alertas de impago (UR-92, UR-93)
hide footbox
skinparam maxMessageSize 170
autonumber "0:"
skinparam sequenceParticipantBackgroundColor #FFFFCC
skinparam sequenceParticipantBorderColor #A80036
skinparam sequenceArrowColor #A80036
skinparam sequenceLifeLineBorderColor #A80036

participant "__: Planificador__" as P
participant "__: ProxyCobros__" as PX
participant "__: ServicioCobros__" as SC
participant "__: ConfiguracionGlobal__" as CG
participant "__f : Factura__" as F
participant "__: ManejadorAlertasCobro__" as MA
participant "__: ServicioNotificaciones__" as SN

P -> P ++ : ejecutarVencimientos()
create participant "__e : EjecucionProceso__" as E
P --> E : EjecucionProceso(VENCIMIENTOS)

== 1. Pasar a VENCIDA (tabla de transiciones de la Entrega 1) ==

P -> PX ++ : actualizarVencimientos(fecha : Date)
PX -> PX : autorizarYRegistrar(operacion : OperacionProtegida)
note right of PX
  Solicitante: la IdentidadSistema que el
  planificador deja en ContextoSeguridad;
  no es un valor de Rol
  y solo puede lanzar las tareas programadas.
  Auditoría con usuario nulo (= Sistema).
  Si rechaza, el planificador lo registra como
  fallo en EjecucionProceso y salta una alerta (CU-56).
end note
PX -> SC ++ : actualizarVencimientos(fecha : Date)
SC ->o] : buscar facturas PENDIENTE con el vencimiento pasado en BD
autonumber stop
SC <--o] : facturas
autonumber resume
loop para cada factura f
  SC -> F ++ : registrarEstadoCobro(estado = VENCIDA, motivo : String)
  create participant "__: HistorialEstadoFactura__" as H
  F --> H : HistorialEstadoFactura(COBRO, PENDIENTE, VENCIDA)
  autonumber stop
  return
  autonumber resume
end
SC ->o] : guardar facturas e historial en BD
autonumber stop
return
return
autonumber resume

== 2. Comprobar los límites de impago ==

P -> PX ++ : comprobarImpagos(fecha : Date)
PX -> PX : autorizarYRegistrar(operacion : OperacionProtegida)
PX -> SC ++ : comprobarImpagos(fecha : Date)
SC -> CG ++ : obtenerValor(clave = "diasMaximosVencida", fecha : Date)
autonumber stop
return limiteDias
autonumber resume
SC -> CG ++ : obtenerValor(clave = "deudaMaximaCliente", fecha : Date)
autonumber stop
return limiteDeuda
autonumber resume
SC ->o] : buscar facturas emitidas con saldo y vencimiento pasado en BD
autonumber stop
SC <--o] : facturas
autonumber resume
note right of SC
  **Todas** las vencidas, no solo las de hoy:
  las que vencieron hace días siguen envejeciendo,
  y también las parcialmente cobradas.
end note

loop para cada factura f
  SC -> SC : estaVencida(f : Factura)
  opt días desde el vencimiento > limiteDias (UR-92)
    SC -[#2E7D32]->> MA ++ : «impago sobre el límite»(tipo = FACTURA_VENCIDA, f)
    MA ->o] : buscar alerta sin resolver de ese tipo para f en BD
    autonumber stop
    MA <--o] : existe
    autonumber resume
    opt no existe
      create participant "__n : Notificacion__" as N
      MA --> N : Notificacion(FACTURA_VENCIDA, ALTA, f)
      MA -> SN ++ : registrarNotificacion(notificacion : Notificacion)
      autonumber stop
      return
      autonumber resume
    end
    deactivate MA
  end
end

loop para cada cliente con facturas vencidas
  SC -> SC : consultarSaldo(cliente : Cliente)
  opt resumen.saldoPendiente > limiteDeuda (UR-93)
    SC -[#2E7D32]->> MA ++ : «impago sobre el límite»(tipo = ALERTA_DEUDA, cliente)
    MA -> MA : igual que arriba, con el cliente
    deactivate MA
  end
end
autonumber stop
return
return
autonumber resume

P -> E ++ : finalizar()
autonumber stop
return
autonumber resume
deactivate P

note over MA, SN
  **No se repite la alerta.** El área 6 avisa cada día
  mientras siga sobre el límite; el área 7 no crea otra
  si ya hay una sin resolver del mismo tipo y elemento.
  Si la tarea falla un día, al siguiente avisa igual.
  Requiere que Notificacion se relacione con la factura
  o el cliente (pendiente en el área 7).
end note

note over SC, F
  **UR-93 puede llegar con hasta un día de retraso:**
  la deuda también crece al emitir una factura (área 3),
  y solo se comprueba en esta tarea. Aceptado para
  la primera versión.
end note
@enduml
