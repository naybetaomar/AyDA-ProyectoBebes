@startuml cu27_enviar_factura
title CU-27 Enviar factura al cliente
hide footbox
skinparam maxMessageSize 120
autonumber "0:"
skinparam sequenceParticipantBackgroundColor #FFFFCC
skinparam sequenceParticipantBorderColor #A80036
skinparam sequenceArrowColor #A80036
skinparam sequenceLifeLineBorderColor #A80036

actor "__: Usuario operativo__" as U
participant "__: InterfazWeb__" as UI
participant "__: ProxyEnvio__" as PX
participant "__: ServicioEnvio__" as SE
participant "__c : Cliente__" as C
participant "__ct : Contacto__" as CT
participant "__: PlantillaComunicacion__" as PL
participant "__: GestorDocumentos__" as GD
participant "__: AdaptadorCorreo__" as AC
participant "__: ServicioCorreoSimulado__" as SCS
participant "__: ServicioFacturacion__" as SF
participant "__f : Factura__" as F

U -> UI ++ : enviarFactura(f : Factura)
UI -> PX ++ : enviarFactura(factura : Factura)
PX -> PX : autorizarYRegistrar(operacion : OperacionProtegida, cliente : Cliente)
note right of PX
  El Usuario operativo solo puede
  enviar facturas de su cartera.
end note
PX -> SE ++ : enviarFactura(factura : Factura)
note right of SE
  Rechaza la factura si no
  está EMITIDA (PRE-1).
end note
SE -> C ++ : contactoFacturacion()
autonumber stop
return ct
autonumber resume
SE -> CT ++ : tieneConsentimiento(canal = ct.canalPreferido)
autonumber stop
return true
autonumber resume
note right of CT
  WhatsApp solo con número válido y
  consentimiento (RB-28). Sin destinatario
  válido, el envío se rechaza: hay que
  revisar los contactos (CU-03).
end note
SE -> PL ++ : generarTexto(factura : Factura)
autonumber stop
return texto
autonumber resume
SE -> GD ++ : obtenerPdf(factura : Factura)
autonumber stop
return pdf
autonumber resume
create participant "__m : Mensaje__" as M
SE --> M : Mensaje(plantilla, factura, contacto, canal)
SE -> M : registrarIntento()
SE -> AC ++ : enviar(mensaje = m)
AC -> SCS ++ : enviarCorreo(destino : String, asunto : String, cuerpo : String)
autonumber stop
return aceptado
return aceptado
autonumber resume
note right of AC
  **Adapter**: con WhatsApp, el mismo
  enviar() lo atiende AdaptadorWhatsApp.
end note

alt envío aceptado
  SE -> M : marcarEnviado(fecha : DateTime)
  SE -> SF ++ : registrarEstadoEnvio(factura : Factura, estado = ENVIADA)
  SF -> F ++ : registrarEstadoEnvio(estado = ENVIADA)
  autonumber stop
  return
  return
  autonumber resume
else el canal rechaza el envío
  SE -> M : marcarFallido(motivo : String)
  SE -> SF ++ : registrarEstadoEnvio(factura : Factura, estado = FALLO_ENVIO)
  SF -> F ++ : registrarEstadoEnvio(estado = FALLO_ENVIO)
  autonumber stop
  return
  return
  autonumber resume
  SE -[#2E7D32]->>] : «fallos de envío»(factura : Factura, mensaje : Mensaje)
  note right of SE
    Lo escucha ManejadorAlertasEnvio
    (área 7): alerta en la pantalla de
    trabajo (CU-37). Se gestiona en CU-28.
  end note
end

autonumber stop
return m
return m
return resultado del envío
autonumber resume

note over SF, F
  El área 5 no toca la factura: pide el cambio
  de estado de envío al área 3. Cada cambio deja
  su HistorialEstadoFactura (tipo ENVIO, FR-09).
end note
@enduml
