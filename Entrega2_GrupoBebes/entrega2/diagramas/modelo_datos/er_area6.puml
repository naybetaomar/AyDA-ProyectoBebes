@startuml er_area6
title E-R físico — Área 6: Cobros, conciliación y saldo — PROPUESTA
hide circle
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60

package "Área 6 — Cobros, conciliación y saldo" #E8F4EA {
  entity movimiento_cobro {
    * id : BIGINT <<PK>>
    --
    * origen : VARCHAR(10) {PASARELA, BANCO}
    * id_externo : VARCHAR(100)
    referencia : VARCHAR(100)
    * importe : DECIMAL(12,2)
    * moneda : CHAR(3)
    * fecha_movimiento : TIMESTAMP
    datos_confirmacion : TEXT
    * en_revision : BOOLEAN
    motivo_revision : VARCHAR(500)
  }

  entity conciliacion {
    * id : BIGINT <<PK>>
    --
    * movimiento_cobro_id : BIGINT <<FK>>
    * factura_id : BIGINT <<FK>>
    * importe_aplicado : DECIMAL(12,2)
    * fecha : TIMESTAMP
    fecha_deshecho : TIMESTAMP
    motivo_deshacer : VARCHAR(500)
    realizado_por_id : BIGINT <<FK>>
    deshecho_por_id : BIGINT <<FK>>
  }

  entity baja_contable {
    * id : BIGINT <<PK>>
    --
    * factura_id : BIGINT <<FK>> <<UNIQUE>>
    * solicitud_excepcion_id : BIGINT <<FK>> <<UNIQUE>>
    * tipo : VARCHAR(15) {ANULADA, INCOBRABLE}
    * importe_dado_de_baja : DECIMAL(12,2)
    * motivo : VARCHAR(500)
    * fecha : TIMESTAMP
  }
}

package "Otras áreas (referencias)" #EEEEEE {
  entity factura <<área 3>> {
    * id : BIGINT <<PK>>
  }
  entity solicitud_excepcion <<área 4>> {
    * id : BIGINT <<PK>>
  }
  entity usuario <<área 9>> {
    * id : BIGINT <<PK>>
  }
}

movimiento_cobro ||--o{ conciliacion
factura ||--o{ conciliacion
factura ||--o| baja_contable
solicitud_excepcion ||--o| baja_contable
usuario |o--o{ conciliacion : realizada / deshecha por

note right of conciliacion
  **Índice único parcial** (movimiento_cobro_id, factura_id)
  WHERE fecha_deshecho IS NULL — FR-87.
  CHECK: fecha_deshecho, motivo_deshacer y
  deshecho_por_id, todos nulos o todos no nulos.
  **En la aplicación** (suman filas o cruzan tablas):
  importe_aplicado ≤ saldo pendiente de la factura;
  suma de conciliaciones vigentes ≤ importe del
  movimiento (A-28); misma moneda (FR-84).
end note

note bottom of movimiento_cobro
  **UNIQUE** (origen, id_externo) — CU-34 FE-1.
  CHECK: en revisión ⇒ motivo_revision obligatorio.
  El estado no se guarda: se deriva.
end note

note as Auditoria
  **Trazabilidad (NFR-03):** todas las tablas llevan creado_por, creado_en,
  modificado_por, modificado_en (FK a usuario; nulo = Sistema).
  No se dibujan. Saldo pendiente: no es columna (lo calcula
  ServicioCobros). Leyenda: * = NOT NULL.
end note
@enduml
