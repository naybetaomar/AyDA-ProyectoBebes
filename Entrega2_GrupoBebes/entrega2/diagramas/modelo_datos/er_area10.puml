@startuml er_area10
title E-R físico — Área 10: Configuración y sistema
hide circle
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60

package "Área 10 — Configuración y sistema" #FFF8E5 {
  entity configuracion_global {
    * id : BIGINT <<PK>>
    --
    * nombre : VARCHAR(100)
    * descripcion : VARCHAR(255)
  }

  entity entrada_configuracion {
    * id : BIGINT <<PK>>
    --
    * clave : VARCHAR(100)
    * valor : TEXT
    * tipo_dato : VARCHAR(10) {ENTERO, DECIMAL, BOOLEANO, TEXTO,
      JSON, MONEDA, FECHA}
    * descripcion : VARCHAR(255)
    * validada : BOOLEAN
    * fecha_vigencia_desde : DATE
    fecha_vigencia_hasta : DATE
    .. asociaciones ..
    * configuracion_global_id : BIGINT <<FK>> (CASCADE)
  }

  entity tarea_programada {
    * id : BIGINT <<PK>>
    --
    * tipo : VARCHAR(40) <<UNIQUE>> {TipoProceso}
    * cron : VARCHAR(50)
    * activa : BOOLEAN
  }

  entity ejecucion_proceso {
    * id : BIGINT <<PK>>
    --
    * tipo : VARCHAR(40) {TipoProceso}
    * fecha_inicio : TIMESTAMP
    fecha_fin : TIMESTAMP
    * procesados : INTEGER
    * fallos : INTEGER
    causa : TEXT
    * estado : VARCHAR(25) {EN_CURSO, COMPLETADA,
      COMPLETADA_CON_FALLOS, FALLIDA, CANCELADA}
  }

  entity detalle_fallo {
    * id : BIGINT <<PK>>
    --
    * entidad_afectada : VARCHAR(150)
    * motivo : TEXT
    codigo_incidencia : VARCHAR(50)
    .. asociaciones ..
    * ejecucion_proceso_id : BIGINT <<FK>> (CASCADE)
  }

  entity error_tecnico {
    * id : BIGINT <<PK>>
    --
    * codigo_incidencia : VARCHAR(50) <<UNIQUE>>
    * mensaje_interno : TEXT
    * fecha : TIMESTAMP
    * severidad : VARCHAR(10) {INFO, WARNING, ERROR, CRITICO}
    * origen : VARCHAR(100)
    traza : TEXT
    * resuelto : BOOLEAN
    fecha_resolucion : TIMESTAMP
    .. asociaciones ..
    ejecucion_proceso_id : BIGINT <<FK>>
    resuelto_por_id : BIGINT <<FK>>
  }

  entity calendario_laboral {
    * id : BIGINT <<PK>>
    --
    * nombre : VARCHAR(100)
    * pais : VARCHAR(50)
    * anio : INTEGER
  }

  entity dia_laborable_calendario {
    * id : BIGINT <<PK>>
    --
    * dia_semana : VARCHAR(10) {LUNES ... DOMINGO}
    .. asociaciones ..
    * calendario_laboral_id : BIGINT <<FK>> (CASCADE)
  }

  entity fecha_festiva {
    * id : BIGINT <<PK>>
    --
    * fecha : DATE
    * descripcion : VARCHAR(150)
    * ambito : VARCHAR(10) {NACIONAL, REGIONAL, LOCAL}
    .. asociaciones ..
    * calendario_laboral_id : BIGINT <<FK>> (CASCADE)
  }
}

package "Otras áreas" #EEEEEE {
  entity usuario <<área 9>> {
    * id : BIGINT <<PK>>
  }
}

configuracion_global ||--|{ entrada_configuracion : contiene
ejecucion_proceso ||--o{ detalle_fallo : registra
ejecucion_proceso |o--o{ error_tecnico : agrega
calendario_laboral ||--|{ dia_laborable_calendario : define
calendario_laboral ||--o{ fecha_festiva : contiene
usuario |o--o{ error_tecnico : resuelve

note right of entrada_configuracion
  EXCLUDE: una misma clave no puede tener
  dos vigencias que se solapen [desde, hasta).
  CHECK: hasta nula o posterior a desde.
end note

note right of ejecucion_proceso
  CHECK: EN_CURSO si y solo si no tiene fecha_fin.
  CHECK: FALLIDA o CANCELADA exigen causa.
  CHECK: procesados y fallos no negativos.
end note

note right of error_tecnico
  CHECK: resuelto si y solo si tiene fecha_resolucion;
  sin resolver no tiene resuelto_por_id
  (resuelto con resuelto_por_id nulo = Sistema).
end note

note bottom of fecha_festiva
  UNIQUE (calendario_laboral_id, fecha) y
  UNIQUE (calendario_laboral_id, dia_semana)
  en dia_laborable_calendario.
  calendario_laboral: UNIQUE (pais, anio).
  Que la fecha sea del año del calendario
  lo comprueba el servicio (cruza tablas).
end note

legend bottom left
  * = NOT NULL. Trazabilidad (creado_por, creado_en, modificado_por,
  modificado_en) en configuracion_global, entrada_configuracion,
  tarea_programada y calendario_laboral; dia_laborable_calendario y
  fecha_festiva solo creado_por y creado_en. No se dibuja.
  ejecucion_proceso, detalle_fallo y error_tecnico son registros en sí mismos.
endlegend
@enduml
