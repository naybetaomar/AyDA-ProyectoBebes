@startuml area10_1_configuracion
title Área 10 — Configuración

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle
hide empty members

package "Área 10 — Configuración" #LightYellow {

  class ConfiguracionGlobal {
    - id : Long {readOnly}
    - nombre : String
    - descripcion : String
    - /numeroEntradas : Integer
    + obtenerEntrada(clave : String) : EntradaConfiguracion
    + obtenerValor(clave : String, fecha : Date) : Object
    + validarEntrada(clave : String, valor : String) : ResultadoValidacion
    + actualizarEntrada(clave : String, valor : String) : ResultadoActualizacion
    + listarVigentes(fecha : Date) : EntradaConfiguracion [0..*]
  }

  class EntradaConfiguracion {
    - clave : String {readOnly}
    - valor : String
    - tipoDato : TipoDatoConfig
    - descripcion : String
    - validada : Boolean
    - fechaVigenciaDesde : Date
    - fechaVigenciaHasta : Date [0..1]
    + esVigente(fecha : Date) : Boolean
    + validar() : ResultadoValidacion
  }

  class ResultadoValidacion <<DTO>> {
    - valido : Boolean
    - errores : String [0..*]
  }

  class ResultadoActualizacion <<DTO>> {
    - exito : Boolean
    - mensaje : String
    - entradaActualizada : EntradaConfiguracion [0..1]
  }
}

enum TipoDatoConfig {
  ENTERO
  DECIMAL
  BOOLEANO
  TEXTO
  JSON
  MONEDA
  FECHA
}

package "Área 9 — Seguridad y Auditoría" {
  class Usuario <<referencia área 9>>
}

ConfiguracionGlobal "1" *-- "1..*" EntradaConfiguracion : contiene >
EntradaConfiguracion --> TipoDatoConfig : usa >
ConfiguracionGlobal ..> Usuario : modificadoPor (auditoría) >
ConfiguracionGlobal ..> ResultadoValidacion : devuelve >
ConfiguracionGlobal ..> ResultadoActualizacion : devuelve >
EntradaConfiguracion ..> ResultadoValidacion : devuelve >

note right of ConfiguracionGlobal
  **Punto de entrada del área 10** para la configuración,
  a través del proxy (solo Superadministrador puede
  actualizar). Quién hace el cambio no es un parámetro:
  lo da el ContextoSeguridad y queda en modificadoPor.
  Las demás áreas leen con obtenerValor(clave, fecha).
end note



@enduml