  + modificarRelacion(relacion : RelacionComercial, condicionesPago : String, fechaInicio : Date, rango : RangoTarifa) : void
  + listarPendientesActivacion(fecha : Date) : Cliente [0..*]
  + comprobarBaja(cliente : Cliente, fecha : Date) : String [0..1]
  + darDeBaja(relacion : RelacionComercial, motivo : String, fecha : Date) : void
  + calcularEstadoCliente(cliente : Cliente, fecha : Date) : EstadoCliente
  .. Pausas (CU-11) ..
  + pausar(relacion : RelacionComercial, motivo : String, fechaInicio : Date, fechaPrevistaReactivacion : Date) : Pausa
  + reactivar(relacion : RelacionComercial, fecha : Date) : void
  + avisarReactivacionesPendientes(fecha : Date) : void
  .. Revisión anual (CU-13) ..
  + prepararRevisionAnual(anio : Integer) : RevisionAnualPlan [0..*]
  + corregirFacturacionAnual(revision : RevisionAnualPlan, importe : Decimal, fuente : String, fecha : Date, usuario : Usuario) : void
  + aplicarRevision(revision : RevisionAnualPlan, fechaEfecto : Date, aprobador : Usuario) : void
  + mantenerPlan(revision : RevisionAnualPlan, aprobador : Usuario) : void
