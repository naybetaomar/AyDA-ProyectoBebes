@startuml area1_clientes_er
hide circle
skinparam linetype ortho
title Área 1 — Modelo entidad-relación de clientes

' ===== Entidades del área 1 =====
entity "Cliente" as cliente {
  * id : BIGINT <<PK>>
  --
  * razon_social : VARCHAR
  * identificador_fiscal : VARCHAR
  * pais : VARCHAR
  * moneda : VARCHAR
  direccion : VARCHAR
  * estado_cliente : VARCHAR <<enum EstadoCliente>>
  * datos_pendientes : BOOLEAN
  * anonimizado : BOOLEAN
}

entity "Contacto" as contacto {
  * id : BIGINT <<PK>>
  --
  * cliente_id : BIGINT <<FK>>
  * nombre : VARCHAR
  * email : VARCHAR
  telefono : VARCHAR
  idioma : VARCHAR
  canal_preferido : VARCHAR <<enum Canal>>
  * es_contacto_facturacion : BOOLEAN
  * anonimizado : BOOLEAN
}

entity "ConsentimientoCanal" as consentimiento {
  * contacto_id : BIGINT <<PK, FK>>
  * canal : VARCHAR <<PK, enum Canal>>
  --
  * otorgado : BOOLEAN
  * fecha : DATE
}

entity "Documento" as documento {
  * id : BIGINT <<PK>>
  --
  cliente_id : BIGINT <<FK>>
  factura_id : BIGINT <<FK>>
  * nombre : VARCHAR
  formato : VARCHAR
  tamano : BIGINT
  * ruta : VARCHAR
}

entity "Etiqueta" as etiqueta {
  * id : BIGINT <<PK>>
  --
  * nombre : VARCHAR
}

entity "ClienteEtiqueta" as cliente_etiqueta {
  * cliente_id : BIGINT <<PK, FK>>
  * etiqueta_id : BIGINT <<PK, FK>>
}

entity "CategoriaFactura" as categoria {
  * id : BIGINT <<PK>>
  --
  * nombre : VARCHAR
}

' ===== Entidades de otras áreas (solo referencia) =====
entity "Factura" as factura <<referencia>> {
  * id : BIGINT <<PK>>
  --
  * cliente_id : BIGINT <<FK>>
  categoria_factura_id : BIGINT <<FK>>
}

entity "RelacionComercial" as relacion <<referencia>> {
  * id : BIGINT <<PK>>
  --
  * cliente_id : BIGINT <<FK>>
}

entity "AsignacionCliente" as asignacion <<referencia>> {
  * id : BIGINT <<PK>>
  --
  * usuario_id : BIGINT <<FK>>
  * cliente_id : BIGINT <<FK>>
  * desde : DATE
  hasta : DATE
}

entity "Usuario" as usuario <<referencia>> {
  * id : BIGINT <<PK>>
}

' ===== Relaciones del núcleo =====
cliente ||--|{ contacto : "tiene (RB-27: ≥1)"
contacto ||--o{ consentimiento : "tiene"
cliente ||--o{ cliente_etiqueta : "se clasifica con"
etiqueta ||--o{ cliente_etiqueta : "clasifica"
categoria |o--o{ factura : "clasifica"
cliente |o--o{ documento : "adjunto a"
factura |o--o{ documento : "adjunto a"

' ===== Relaciones con otras áreas =====
cliente ||--o{ factura : "recibe"
cliente ||--o{ relacion : "tiene"
usuario ||--o{ asignacion : "tiene asignados"
cliente ||--o{ asignacion : "es asignado en"

' ===== Notas =====
note right of cliente
  RB-27: al menos un Contacto (regla de aplicación,
  no expresable solo con FK).
  Dec. 5 pendiente: ¿estado_cliente almacenado
  o derivado de la relación activa?
  Campos de trazabilidad (NFR-03) en todas las
  tablas: creado_por, creado_en, modificado_por,
  modificado_en.
end note

note bottom of documento
  Dec. 4/6 pendiente: destino (Cliente o Factura).
  Dos FK nullables; añadir CHECK para exigir que
  al menos una (o exactamente una) esté informada.
  formato sin enumerar.
end note

note bottom of contacto
  Anonimización (RGPD): al anonimizar un cliente se
  anonimizan sus contactos; los datos personales
  se sobrescriben, la fila se conserva.
end note

note bottom of etiqueta
  Etiqueta y CategoriaFactura: opcionales
  (CU-08, FR-81, FR-108). No sustituyen
  a los estados derivados (RB-34).
end note
@enduml
