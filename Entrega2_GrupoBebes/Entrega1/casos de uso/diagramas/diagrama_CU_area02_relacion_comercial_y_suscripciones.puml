@startuml
' Diagrama - Relación comercial y suscripciones (CU-XX = especificación en el .md)
title Relación comercial y suscripciones
left to right direction
skinparam packageStyle rectangle

actor "Lector" as Lector
actor "Administrador" as Admin
actor "Superadministrador" as Super
Admin --|> Lector
Super --|> Admin

rectangle "Aplicación de facturación y cobros" {
  usecase "CU-10\nGestionar relación comercial" as CU10
  usecase "CU-11\nPausar y reactivar suscripción" as CU11
  usecase "CU-12\nDar de baja a un cliente" as CU12
  usecase "CU-13\nRevisar anualmente el plan de un cliente" as CU13
  usecase "CU-14\nConfigurar tarifas globales" as CU14
}
Lector -- CU10
Lector -- CU11
Lector -- CU12
Admin -- CU13
Super -- CU13
Super -- CU14
@enduml
