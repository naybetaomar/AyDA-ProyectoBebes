@startuml
' Diagrama  - Usuarios, seguridad y auditoría (CU-XX = especificación en el .md)
title Usuarios, seguridad y auditoría
left to right direction
skinparam packageStyle rectangle

actor "Lector" as Lector
actor "Administrador" as Admin
actor "Superadministrador" as Super
Admin --|> Lector
Super --|> Admin

rectangle "Aplicación de facturación y cobros" {
  usecase "CU-48\nAcceder al sistema" as CU48
  usecase "CU-49\nGestionar usuarios" as CU49
  usecase "CU-50\nAsignar y delegar clientes" as CU50
  usecase "CU-51\nDescargar documentos autorizados" as CU51
  usecase "CU-52\nConsultar auditoría de negocio y exportaciones" as CU52
  usecase "CU-53\nRealizar y consultar copias de seguridad" as CU53
  usecase "CU-59\nRestaurar copia de seguridad" as CU59
}
Lector -- CU48
Admin -- CU49
Admin -- CU50
Lector -- CU51
Super -- CU52
Super -- CU53
Super -- CU59
note right of CU59 : Precondición: existe una copia de seguridad (CU-53)
@enduml
