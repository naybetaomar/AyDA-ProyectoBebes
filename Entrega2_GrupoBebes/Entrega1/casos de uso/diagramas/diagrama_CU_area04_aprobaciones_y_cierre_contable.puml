@startuml
' Diagrama  - Aprobaciones y cierre contable (CU-XX = especificación en el .md)
title Aprobaciones y cierre contable
left to right direction
skinparam packageStyle rectangle

actor "Lector" as Lector
actor "Administrador" as Admin
actor "Superadministrador" as Super
Admin --|> Lector
Super --|> Admin

rectangle "Aplicación de facturación y cobros" {
  usecase "CU-22\nProponer excepción o factura para revisión" as CU22
  usecase "CU-23\nResolver propuesta o autorizar sobre el umbral" as CU23
  usecase "CU-24\nConsultar mis solicitudes económicas" as CU24
  usecase "CU-25\nCerrar un periodo contable" as CU25
  usecase "CU-26\nReabrir un periodo cerrado" as CU26
}
Lector -- CU22
Admin -- CU23
Super -- CU23
Lector -- CU24
Admin -- CU25
Super -- CU26
note right of CU23 : Precondición: existe una propuesta pendiente (CU-22)
note right of CU26 : Precondición: el periodo está cerrado (CU-25)
@enduml
