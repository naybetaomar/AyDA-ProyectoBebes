@startuml area9_2_patron_proxy_permisos
title Área 9 — Usuarios, seguridad y auditoria.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam nodesep 60
skinparam ranksep 70
hide empty members

class Planificador <<referencia>>
class EjecucionProceso <<referencia>>

interface Solicitante {
  +esSistema() : boolean
}

class Usuario
class IdentidadSistema {
  -nombre : String
  -operacionesPermitidas : Set<OperacionProtegida>
  --
  +puede(operacion : OperacionProtegida) : boolean
}


interface IServicioFacturacion {
  +emitirPuntual(solicitante : Solicitante, datos : DatosFactura) : Factura
  +generarRecurrentes(solicitante : Solicitante)
  +emitirRectificativa(solicitante : Solicitante, datos : DatosFactura) : Factura
  +consultarFacturas(solicitante : Solicitante, cliente : Cliente) : List<Factura>
  +marcarEnDisputa(solicitante : Solicitante, factura : Factura, motivo : String)
}

class ServicioFacturacion <<referencia>>

abstract class ProxyPermisos {
  #autorizarYRegistrar(solicitante : Solicitante, operacion : OperacionProtegida, cliente : Cliente [0..1], usuarioAfectado : Usuario [0..1])
}

class ProxyFacturacion

interface IServicioUsuarios {
  +invitarUsuario(solicitante : Solicitante, email : String, rol : Rol) : Usuario
  +cambiarRol(solicitante : Solicitante, usuario : Usuario, nuevoRol : Rol)
  +desactivar(solicitante : Solicitante, usuario : Usuario)
  +asignarCliente(solicitante : Solicitante, usuario : Usuario, cliente : Cliente) : AsignacionCliente
  +reasignarCliente(solicitante : Solicitante, cliente : Cliente, nuevoResponsable : Usuario)
  +delegarClientes(solicitante : Solicitante, origen : Usuario, suplente : Usuario, desde : Date, caducidad : Date) : Delegacion
  +caducarDelegaciones(solicitante : Solicitante)
}

class ServicioUsuarios

class ProxyUsuarios

class ControlAcceso {
  +autorizar(solicitante : Solicitante, operacion : OperacionProtegida, cliente : Cliente [0..1], usuarioAfectado : Usuario [0..1])
}

enum OperacionProtegida {
  EMITIR_PUNTUAL
  GENERAR_RECURRENTES
  EMITIR_RECTIFICATIVA
  CONSULTAR_FACTURAS
  MARCAR_EN_DISPUTA
  CAMBIAR_ROL
  DESACTIVAR_USUARIO
  INVITAR_USUARIO
  ASIGNAR_CLIENTE
  REASIGNAR_CLIENTE
  DELEGAR_CLIENTES
  CADUCAR_DELEGACIONES
}

class AccesoDenegado {
  -motivo : String
}

enum Rol <<referencia>>
class AsignacionCliente <<referencia>>
class Delegacion <<referencia>>
class RegistroAuditoria <<referencia>>


Planificador ..> IServicioFacturacion : llama a través del proxy
Planificador "1" --> "1" IdentidadSistema : actúa como >
Planificador ..> AccesoDenegado : captura
Planificador ..> EjecucionProceso : registra el rechazo

IServicioFacturacion <|.. ProxyFacturacion
IServicioFacturacion <|.. ServicioFacturacion
ProxyPermisos <|-- ProxyFacturacion
ProxyFacturacion "1" --> "1" IServicioFacturacion : real (delega en) >

IServicioUsuarios <|.. ProxyUsuarios
IServicioUsuarios <|.. ServicioUsuarios
ProxyPermisos <|-- ProxyUsuarios
ProxyUsuarios "1" --> "1" IServicioUsuarios : real (delega en) >
ServicioUsuarios ..> Usuario : gestiona
ServicioUsuarios ..> AsignacionCliente : gestiona
ServicioUsuarios ..> Delegacion : gestiona
Planificador ..> IServicioUsuarios : caducar delegaciones, a través del proxy

ProxyPermisos "1" --> "1" ControlAcceso : control >
ProxyPermisos ..> RegistroAuditoria : crea >

Solicitante <|.. Usuario
Solicitante <|.. IdentidadSistema

ControlAcceso ..> Solicitante
ControlAcceso ..> OperacionProtegida
ControlAcceso ..> Rol : consulta
ControlAcceso ..> AsignacionCliente : consulta
ControlAcceso ..> Delegacion : consulta
ControlAcceso ..> AccesoDenegado : lanza
IdentidadSistema ..> OperacionProtegida





@enduml